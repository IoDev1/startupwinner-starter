# Copy to .env.local for development, and set the same names on Vercel.
# Nothing here is required to build; each service switches on when its keys are set.

# The public address, used in emails and Stripe redirects (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server only: Stripe webhooks and account deletion. Never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Stripe → Developers → API keys (test keys while building, live keys at launch).
STRIPE_SECRET_KEY=sk_test_xxx
# The recurring price people subscribe to (Product catalog → your product → price ID).
STRIPE_PRICE_ID=price_xxx
# Developers → Webhooks → your endpoint (https://<site>/api/stripe/webhook) → signing secret.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend → API keys. EMAIL_FROM must use a domain verified in Resend (SPF/DKIM).
RESEND_API_KEY=re_xxx
EMAIL_FROM="My App <hello@example.com>"

# PostHog → Project settings (optional).
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry → Project settings → Client keys (optional). The auth token uploads source maps.
NEXT_PUBLIC_SENTRY_DSN=https://xxx@o0.ingest.sentry.io/0
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
