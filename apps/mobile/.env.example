# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app,
# so only put public values here (never the Supabase secret/service key).

# Supabase project URL: Supabase dashboard > Project Settings > API (or Data API).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_...; the legacy "anon" key also works).
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Base URL of the web app (apps/web), used for /api/account/delete.
# On a device, localhost is the phone itself: use your deployed URL or your
# computer's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_WEB_URL=https://your-app.vercel.app
